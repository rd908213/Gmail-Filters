# Template for .env
# Copy this file to .env and fill in your credentials

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# UI Mode: Suppress verbose terminal output and use a clean single-line loading bar:
# [=======-------------] <current_domain>
PROGRESS_BAR_MODE=true

# Batch / Chunk Processing Configuration (Optimized for Google Pro / Workspace IMAP rate limits):
# Process emails in synchronous batches (recommended: 25-100) instead of 1-by-1 to drastically increase speed
EMAIL_CHUNK_SIZE=50

# Polite delay in seconds between chunked IMAP calls to prevent tripping Google burst rate limits (recommended: 0.05-0.1)
CHUNK_DELAY=0.05

